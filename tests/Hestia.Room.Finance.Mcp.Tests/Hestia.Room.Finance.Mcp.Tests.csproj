<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Microsoft Testing Platform: the test project is a standalone executable (see test.runner in global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- packages.lock.json: exact versions and content hashes of all dependencies (direct and transitive). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hestia.Room.Finance.Mcp\Hestia.Room.Finance.Mcp.csproj" />
    <ProjectReference Include="..\Hestia.Room.Finance.Testing\Hestia.Room.Finance.Testing.csproj" />
  </ItemGroup>

</Project>
