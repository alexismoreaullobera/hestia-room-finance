<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test support shared by the test projects (SQL Server fixture): a library, no test in it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- packages.lock.json: exact versions and content hashes of all dependencies (direct and transitive). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- IAsyncLifetime and TestContext only: the test runner stays in the test projects. Same version as xunit.v3.mtp-v2. -->
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hestia.Room.Finance.Infrastructure\Hestia.Room.Finance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
