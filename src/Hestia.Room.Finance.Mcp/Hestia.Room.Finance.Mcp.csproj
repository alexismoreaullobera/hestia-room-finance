<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MCP Apps (ModelContextProtocol.Extensions.Apps) is experimental: MCPEXP003 is expected.
    Remove once the API is stable. -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
    <!-- packages.lock.json: exact versions and content hashes of all dependencies (direct and transitive). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Key of the local secrets store (outside the repository), read in Development: the connection string. -->
    <UserSecretsId>hestia-room-finance-mcp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal helpers (month argument, text formats) are tested directly. -->
    <InternalsVisibleTo Include="Hestia.Room.Finance.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hestia.Room.Finance.Infrastructure\Hestia.Room.Finance.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    MCP Apps views (ui:// resources): built by the views project (src/Hestia.Room.Finance.Views, TypeScript, Vite),
    one self-contained HTML each, then embedded in this assembly. dotnet build runs npm ci when the lock file changed,
    and the Vite build when a source changed (Inputs/Outputs): Node.js is a prerequisite, as Docker for the tests.
  -->
  <PropertyGroup>
    <ViewsProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'Hestia.Room.Finance.Views'))</ViewsProjectDir>
    <ViewsDistDir>$(ViewsProjectDir)dist\</ViewsDistDir>
  </PropertyGroup>

  <ItemGroup>
    <ViewsSource Include="$(ViewsProjectDir)src\**\*;$(ViewsProjectDir)views\*.html" />
    <ViewsSource Include="$(ViewsProjectDir)package.json;$(ViewsProjectDir)package-lock.json;$(ViewsProjectDir)build.js;$(ViewsProjectDir)vite.config.ts" />
    <ViewsSource Include="$(ViewsProjectDir)tsconfig.json;$(ViewsProjectDir)tsconfig.build.json" />
    <ViewsOutput Include="$(ViewsDistDir)month-overview.html;$(ViewsDistDir)cash-flow-forecast.html;$(ViewsDistDir)subscriptions.html" />
    <!-- Seen by the fast up-to-date check of Visual Studio and by dotnet watch, which ignore custom item types. -->
    <UpToDateCheckInput Include="@(ViewsSource)" />
    <Watch Include="@(ViewsSource)" />
  </ItemGroup>

  <!-- Not in the design-time builds of the IDE, which must stay fast. -->
  <Target Name="CheckNodeForViews" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="node --version" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="NodeVersion" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0' or !$(NodeVersion.StartsWith('v24.'))"
           Text="Node.js 24 is required to build the MCP Apps views (src/Hestia.Room.Finance.Views), found '$(NodeVersion)': see the README." />
  </Target>

  <!--
    npm ci only when the lock file is newer than the installed packages (npm writes node_modules/.package-lock.json).
    ignore-scripts given explicitly: an inherited npm_config_ignore_scripts cannot turn the install scripts back on.
  -->
  <Target Name="RestoreViews" DependsOnTargets="CheckNodeForViews" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(ViewsProjectDir)package-lock.json" Outputs="$(ViewsProjectDir)node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund --ignore-scripts" WorkingDirectory="$(ViewsProjectDir)" />
  </Target>

  <Target Name="BuildViews" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreViews" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(ViewsSource)" Outputs="@(ViewsOutput)">
    <Exec Command="npm run build" WorkingDirectory="$(ViewsProjectDir)" />
  </Target>

  <!--
    Added after the views build, never skipped: the built files do not exist yet when the project is evaluated.
    Explicit resource names (views/...): the default name depends on the root namespace and rewrites folder names.
  -->
  <Target Name="EmbedViews" AfterTargets="BuildViews" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <EmbeddedResource Include="@(ViewsOutput)" LogicalName="views/%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <!-- dotnet clean (and Rebuild) also empties the built views, which then build again. -->
  <Target Name="CleanViews" AfterTargets="Clean">
    <RemoveDir Directories="$(ViewsDistDir)" />
  </Target>

</Project>
