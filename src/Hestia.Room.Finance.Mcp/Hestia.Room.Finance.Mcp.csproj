<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MCP Apps (ModelContextProtocol.Extensions.Apps) is experimental: MCPEXP003 is expected.
    Remove once the API is stable. -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
    <!-- packages.lock.json: exact versions and content hashes of all dependencies (direct and transitive). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Key of the local secrets store (outside the repository), read in Development: the connection string. -->
    <UserSecretsId>hestia-room-finance-mcp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal helpers (month argument, text formats) are tested directly. -->
    <InternalsVisibleTo Include="Hestia.Room.Finance.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hestia.Room.Finance.Infrastructure\Hestia.Room.Finance.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP Apps views (ui:// resources) and the code they share are embedded in the assembly and served by the MCP server. -->
    <!-- Explicit resource names (views/..., views/shared/...): the default name depends on the root namespace and
    rewrites folder names. WithCulture=false: a file such as view.fr.js stays in this assembly. -->
    <EmbeddedResource Include="Views\*.html" LogicalName="views/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Views\shared\*.css;Views\shared\*.js" LogicalName="views/shared/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
