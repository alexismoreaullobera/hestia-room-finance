<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- packages.lock.json: exact versions and content hashes of all dependencies (direct and transitive). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Transitive pinning: Microsoft.Data.SqlClient 6.1.7 brings System.Security.Cryptography.Pkcs 9.0.11,
         affected by CVE-2026-84008 (high) and CVE-2026-70162 (denial of service, fixed in 10.0.13).
         Remove once the SQL client depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hestia.Room.Finance.Domain\Hestia.Room.Finance.Domain.csproj" />
  </ItemGroup>

</Project>
